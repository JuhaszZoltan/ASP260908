@model MovieGenreViewModel;

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p><a asp-action="Create">Create New</a></p>

<form asp-controller="Movies" asp-action="Index" method="get">
  <p>
    <label>Title: <input type="text" asp-for="SearchString" /></label>
    Genre: 
    <select asp-for="MovieGenre" asp-items="Model.Genres">
        <option value="">all</option>
    </select>

    <input type="submit" value="Filter" />
  </p>
</form>

<table class="table">
  <thead>
    <tr>
      <th>@Html.DisplayNameFor(model => model.Movies![0].Title)</th>
      <th>@Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)</th>
      <th>@Html.DisplayNameFor(model => model.Movies![0].Genre)</th>
      <th>@Html.DisplayNameFor(model => model.Movies![0].Price)</th>
      <th>@Html.DisplayNameFor(model => model.Movies![0].Rating)</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var movie in Model.Movies!)
    {
      <tr>
        <td>@Html.DisplayFor(m => movie.Title)</td>
        <td>@Html.DisplayFor(m => movie.ReleaseDate)</td>
        <td>@Html.DisplayFor(m => movie.Genre)</td>
        <td>@Html.DisplayFor(m => movie.Price)</td>
        <td>@Html.DisplayFor(m => movie.Rating)</td>
        <td>
          <a asp-action="Edit" asp-route-id="@movie.Id">Edit</a> |
          <a asp-action="Details" asp-route-id="@movie.Id">Details</a> |
          <a asp-action="Delete" asp-route-id="@movie.Id">Delete</a>
        </td>
      </tr>
    }
  </tbody>
</table>
